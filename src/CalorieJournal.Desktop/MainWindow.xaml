              <TextBlock Text="备注 · 可选" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BodyNoteBox" Text="{Binding BodyNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxLength="2000" AutomationProperties.Name="身体记录备注"/>
              <Border Background="#EDF3E8" CornerRadius="6" Padding="12" Margin="0,8"><TextBlock x:Name="BodyPreviewText" Text="{Binding BodyPreview}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/></Border>
              <TextBlock Text="新建可带入最近身高、年龄和公式选项，请核对当时资料。历史保留各次输入。" Style="{StaticResource Caption}"/>
            </StackPanel></ScrollViewer>
            <WrapPanel Grid.Row="2" Margin="18,10"><Button x:Name="SaveBodyButton" Content="保存身体记录" Command="{Binding SaveBodyCommand}" Style="{StaticResource PrimaryButton}"/><Button x:Name="NewBodyButton" Content="新建 / 取消" Command="{Binding NewBodyCommand}" Margin="0"/></WrapPanel>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="身体记录与计算" Style="{StaticResource Heading}"/><WrapPanel Margin="0,8,0,0">
              <DatePicker x:Name="BodyFromPicker" SelectedDate="{Binding BodyFrom}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="128" Margin="0,0,6,8" AutomationProperties.Name="身体查询开始日期"/>
              <DatePicker x:Name="BodyToPicker" SelectedDate="{Binding BodyTo}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="128" Margin="0,0,6,8" AutomationProperties.Name="身体查询结束日期"/>
              <Button x:Name="QueryBodyButton" Content="查询" Command="{Binding QueryBodyCommand}" Margin="0,0,0,8"/>
            </WrapPanel><TextBlock Text="{Binding BodySummary}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/></StackPanel>
            <TextBlock Grid.Row="1" Text="BMI为kg÷m²，仅显示数值。代谢参考为Mifflin–St Jeor静息估算（原研究19–78岁），非实测值或每日摄入目标；资料不全时未估算。" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
