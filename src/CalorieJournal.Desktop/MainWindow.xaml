              <TextBlock Text="代谢公式选项 · 可选" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BodySexBox" ItemsSource="{Binding BodySexChoices}" SelectedIndex="{Binding BodySex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代谢公式性别选项"/>
