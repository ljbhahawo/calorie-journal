              <TextBlock Text="测量日期 · 每天一条" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="BodyDatePicker" SelectedDate="{Binding BodyDate}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" AutomationProperties.Name="身体测量日期"/>
              <TextBlock Text="体重 · kg" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BodyWeightBox" Text="{Binding BodyWeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="体重kg"/>
