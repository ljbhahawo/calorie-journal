<Window x:Class="CalorieJournal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日热量记录" Width="1240" Height="820" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Language="zh-CN" Style="{StaticResource {x:Type Window}}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Accent}" Margin="0,0,13,0">
        <Path Data="M 13 29 C 6 18 13 8 32 7 C 33 23 25 33 13 29 M 13 29 L 25 16" Stroke="#F5F8EE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="38" Height="38" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="每日热量记录" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="记录每一餐，了解每天的摄入" Style="{StaticResource Caption}" Margin="0,3,0,0" />
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="16" Background="#E5EDE1" Padding="12,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" /><TextBlock Text="本机保存 · 离线使用" FontSize="12" Foreground="{StaticResource Accent}" /></StackPanel>
      </Border>
    </Grid>

    <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="{Binding TabIndex}" IsEnabled="{Binding NotBusy}">
      <TabItem Header="每日记录">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="318" /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Margin="20,18,20,14">
                <TextBlock Text="{Binding EntryHeading}" Style="{StaticResource Heading}" />
                <TextBlock Text="选择食物计算，或直接填写大卡" Style="{StaticResource Caption}" />
              </StackPanel>
              <ScrollViewer x:Name="EntryFormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,17,0">
                <StackPanel>
                  <TextBlock Text="记录日期" Style="{StaticResource FieldLabel}" />
                  <DatePicker x:Name="EntryDatePicker" SelectedDate="{Binding EntryDate}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" SelectedDateFormat="Short" AutomationProperties.Name="记录日期" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="餐次" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="EntryMealBox" ItemsSource="{Binding EntryMeals}" SelectedItem="{Binding EntryMeal}" DisplayMemberPath="Name" AutomationProperties.Name="餐次" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="时间 · 可选 HH:mm" Style="{StaticResource FieldLabel}" /><TextBox x:Name="EntryTimeBox" Text="{Binding EntryTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="时间" /></StackPanel>
                  </Grid>
                  <TextBlock Text="从食物库查找" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="EntrySearchBox" Text="{Binding EntryFoodQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="支持中文、别名和英文；多个词以空格分隔" AutomationProperties.Name="搜索食物库" Margin="0,5,0,5" />
                  <ComboBox x:Name="FoodChoiceBox" ItemsSource="{Binding FoodChoices}" SelectedItem="{Binding ChosenFood}" DisplayMemberPath="Name" ToolTip="选择后带入单位热量；修改只影响本次记录" AutomationProperties.Name="选择食物" />
                  <TextBlock Text="食物名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="EntryNameBox" Text="{Binding EntryName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="食物名称" />
                  <TextBlock Text="生熟、品牌或加工状态" Style="{StaticResource FieldLabel}" /><TextBox x:Name="EntryPreparationBox" Text="{Binding EntryPreparation, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="食物状态" />
                  <Button Content="改为手动来源" Command="{Binding ClearFoodCommand}" HorizontalAlignment="Left" FontSize="12" MinHeight="30" Padding="10,5" Margin="0,0,0,14" />
                  <CheckBox x:Name="WeightModeBox" Content="按重量计算热量" IsChecked="{Binding WeightMode}" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="重量" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WeightBox" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding WeightMode}" AutomationProperties.Name="重量" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="单位" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="WeightUnitBox" ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding WeightUnit}" IsEnabled="{Binding WeightMode}" AutomationProperties.Name="重量单位" /></StackPanel>
                  </Grid>
                  <TextBlock Text="每100克能量" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="UnitKcalBox" Text="{Binding UnitKcal, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding WeightMode}" AutomationProperties.Name="每100克能量" Margin="0,0,8,8"/>
                    <ComboBox x:Name="EntryEnergyUnitBox" Grid.Column="1" ItemsSource="{Binding EnergyUnits}" SelectedItem="{Binding EntryEnergyUnit}" IsEnabled="{Binding WeightMode}" AutomationProperties.Name="每100克能量单位"/>
                  </Grid><TextBlock Text="{Binding UnitEnergyPreview}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="每100克蛋白质 · g · 可选" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnitProteinBox" Text="{Binding UnitProtein, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding WeightMode}" AutomationProperties.Name="每100克蛋白质g"/>
                  <TextBlock Text="{Binding WeightCalculationDescription}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><Button x:Name="WeightConversionButton" Content="换算可食重量 / 常用份量" Command="{Binding OpenWeightConversionCommand}" IsEnabled="{Binding WeightMode}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                  <Button x:Name="OpenTemplatesButton" Content="餐食模板 · 整餐核对" Command="{Binding OpenTemplatesCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                  <TextBlock Text="直接输入本项热量 · 点击后切换模式" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectKcalBox" Text="{Binding DirectKcal, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="DirectEnergyClicked" GotKeyboardFocus="DirectEnergyFocused" AutomationProperties.Name="直接输入本项热量" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DirectEnergyUnitBox" Grid.Column="1" ItemsSource="{Binding EnergyUnits}" SelectedItem="{Binding DirectEnergyUnit}" AutomationProperties.Name="本项热量单位"/>
                  </Grid><TextBlock Text="本项蛋白质 · g · 可选" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DirectProteinBox" Text="{Binding DirectProtein, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DirectProteinEnabled}" AutomationProperties.Name="本项蛋白质g"/>
                  <TextBlock Text="{Binding ProteinPreview}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <Border Background="#EFF5EB" CornerRadius="7" Padding="12,10" Margin="0,0,0,10"><TextBlock Text="{Binding EnergyPreview}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
                  <TextBlock Text="{Binding EntrySource}" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,14" />
                  <TextBlock Text="备注 · 可选" Style="{StaticResource FieldLabel}" /><TextBox x:Name="EntryNoteBox" Text="{Binding EntryNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" MaxLength="1000" TextWrapping="Wrap" AutomationProperties.Name="摄入备注" />
                </StackPanel>
              </ScrollViewer>
              <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Button x:Name="SaveEntryButton" Content="保存摄入" Command="{Binding SaveEntryCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button x:Name="NewEntryButton" Grid.Column="1" Content="新建 / 取消" Command="{Binding NewEntryCommand}" Margin="0" ToolTip="放弃当前修改并新建记录" />
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
              <Button x:Name="SingleViewButton" Content="单日" Command="{Binding ShowSingleCommand}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ContinuousMode}" Value="False"/><Condition Binding="{Binding MealMode}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#DDEBDD"/><Setter Property="BorderBrush" Value="#90AB95"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <Button x:Name="MealsViewButton" Content="按餐" Command="{Binding ShowMealsCommand}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding MealMode}" Value="True"><Setter Property="Background" Value="#DDEBDD"/><Setter Property="BorderBrush" Value="#90AB95"/></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <Button x:Name="ContinuousViewButton" Content="连续列表" Command="{Binding ShowContinuousCommand}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ContinuousMode}" Value="True"><Setter Property="Background" Value="#DDEBDD" /><Setter Property="BorderBrush" Value="#90AB95" /></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <TextBlock Text="在右侧浏览，在左侧添加或修改" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6" />
            </WrapPanel>
          <ScrollViewer x:Name="SingleDayPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding ContinuousMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
          <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="360">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14" LastChildFill="False">
              <TextBlock Text="当日概览" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="PreviousDayButton" Content="‹" FontSize="21" Padding="11,2" Command="{Binding PreviousDayCommand}" ToolTip="前一天" AutomationProperties.Name="前一天" Margin="0,0,6,0" />
                <DatePicker x:Name="SelectedDatePicker" SelectedDate="{Binding SelectedDate}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" SelectedDateFormat="Short" Width="146" Margin="0,0,6,0" AutomationProperties.Name="查看日期" />
                <Button x:Name="NextDayButton" Content="›" FontSize="21" Padding="11,2" Command="{Binding NextDayCommand}" ToolTip="后一天" AutomationProperties.Name="后一天" Margin="0,0,6,0" />
                <Button x:Name="TodayButton" Content="今天" Command="{Binding TodayCommand}" Margin="0" />
              </StackPanel>
            </DockPanel>
            <Border x:Name="DayTotalCard" Grid.Row="1" Style="{StaticResource Card}" Padding="14,5" Background="#E7EFDF" BorderBrush="#D8E4CF" Margin="0,0,0,10">
              <StackPanel><DockPanel><TextBlock x:Name="DayProteinTextBlock" DockPanel.Dock="Right" Text="{Binding DayProteinText}" ToolTip="{Binding DayProteinText}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="12" Foreground="#546B4E" VerticalAlignment="Center" Margin="12,0,0,0"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding DayTotal}" FontSize="23" FontWeight="SemiBold" Foreground="#254E32"/></Viewbox></DockPanel>
                <TextBlock x:Name="DayGoalTextBlock" Text="{Binding DayGoalText}" ToolTip="{Binding DayGoalText}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#546B4E" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border x:Name="DayEntriesCard" Grid.Row="2" Padding="0">
              <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding MealMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="20,16,20,14"><TextBlock Text="摄入明细" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="左右滚动可查看更多字段" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                <Grid Grid.Row="1" Margin="10,0">
                  <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding DayEntries}" SelectedItem="{Binding SelectedEntry}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="食物" Binding="{Binding FoodNameSnapshot}" Width="190" />
                      <DataGridTextColumn Header="大卡" Binding="{Binding EnergyKcal, StringFormat=N1}" Width="95" ElementStyle="{StaticResource EnergyCell}" />
                      <DataGridTextColumn Header="蛋白质" Binding="{Binding ProteinText}" Width="110"/>
                      <DataGridTextColumn Header="餐次" Binding="{Binding MealNameSnapshot}" Width="85" />
                      <DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="75" />
                      <DataGridTextColumn Header="计算方式" Binding="{Binding Calculation}" Width="250" />
                      <DataGridTextColumn Header="状态" Binding="{Binding PreparationSnapshot}" Width="180" />
                      <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="200" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel x:Name="EntriesEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12,40,12,14">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DayEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Border Width="46" Height="46" CornerRadius="23" Background="#EFF4E9" Margin="0,0,0,12"><TextBlock Text="+" FontSize="28" Foreground="#7A9270" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="这一天还没有记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="在左侧为这一天添加第一项摄入" Style="{StaticResource Caption}" Margin="0,7,0,0" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Border Grid.Row="2" Padding="20,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><WrapPanel>
                  <Button x:Name="EditEntryButton" Content="修改记录" Command="{Binding EditEntryCommand}" />
                  <Button x:Name="CopyEntryButton" Content="复制到今天" Command="{Binding CopyEntryCommand}" ToolTip="复制保存时的数值到今天的新增表单，核对并保存后才写入。" />
                  <Button x:Name="DeleteEntryButton" Content="删除记录" Command="{Binding DeleteEntryCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                </WrapPanel></Border>
              </Grid>
            </Border>
            <Border x:Name="DayMealsPanel" Grid.Row="2">
              <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding MealMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <ListBox x:Name="DayMealsList" ItemsSource="{Binding DayMeals}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="当日按餐浏览">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14"><StackPanel>
                  <Border x:Name="DayMealHeader" Background="#E8F0E8" CornerRadius="6" BorderBrush="{StaticResource Accent}" BorderThickness="4,0,0,0" Padding="10,8"><DockPanel>
                    <Button x:Name="AddMealEntryButton" DockPanel.Dock="Right" Content="添加本餐" Command="{Binding DataContext.AddMealEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0"/>
                    <StackPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/><TextBlock Text="{Binding ProteinSummary}" Style="{StaticResource Caption}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Margin="18,8,0,0" BorderBrush="#BDD0BF" BorderThickness="2,0,0,0" Padding="14,0,0,0"><ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border x:Name="DayMealEntryCard" Background="#F8FAF7" CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,4,0,4" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding FoodNameSnapshot}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding EnergyKcal, StringFormat={}{0:0.0} 大卡}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/><TextBlock Text="{Binding ProteinText, StringFormat=蛋白质 {0}}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Calculation}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PreparationSnapshot}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/></StackPanel>
                      <WrapPanel Grid.Column="1" VerticalAlignment="Top"><Button x:Name="EditMealEntryButton" Content="修改" Command="{Binding DataContext.EditListedEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5"/><Button x:Name="DeleteMealEntryButton" Content="删除" Command="{Binding DataContext.DeleteListedEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,5" Margin="0"/></WrapPanel>
                    </Grid></Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
          </ScrollViewer>
          <Border x:Name="ContinuousPanel" Grid.Row="1" Padding="0" Background="Transparent">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ContinuousMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8">
                <WrapPanel>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="开始日期" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="BrowseFromPicker" SelectedDate="{Binding BrowseFrom}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="132" Margin="0,0,0,6" AutomationProperties.Name="连续列表开始日期" /></StackPanel>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="结束日期" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="BrowseToPicker" SelectedDate="{Binding BrowseTo}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="132" Margin="0,0,0,6" AutomationProperties.Name="连续列表结束日期" /></StackPanel>
                  <Button x:Name="BrowseQueryButton" Content="查询" Command="{Binding LoadBrowseCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Text="{Binding BrowseRangeText}" Style="{StaticResource Caption}" />
              </StackPanel>
              <ListBox x:Name="ContinuousDaysList" Grid.Row="1" ItemsSource="{Binding BrowseDays}" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="按日期连续浏览摄入">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                      <Border x:Name="ContinuousDateHeader" Background="#E5EDE7" CornerRadius="6" Padding="12"><DockPanel LastChildFill="True">
                        <Button x:Name="AddListedEntryButton" DockPanel.Dock="Right" Content="添加" Padding="10,5" MinHeight="32" Margin="8,0,0,0" Command="{Binding DataContext.AddListedEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Date, StringFormat=为{0:yyyy-MM-dd}添加摄入}" />
                        <StackPanel><TextBlock Text="{Binding Date, StringFormat=yyyy-MM-dd · dddd}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/><TextBlock Text="{Binding ProteinSummary}" Style="{StaticResource Caption}"/></StackPanel>
                      </DockPanel></Border>
                      <TextBlock Text="点击添加，为这一天记录摄入" Margin="0,12,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Entries.Length}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <Border Margin="16,10,0,0" BorderBrush="#BDD0BF" BorderThickness="2,0,0,0" Padding="12,0,0,0"><ItemsControl ItemsSource="{Binding Meals}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
                        <Border x:Name="ContinuousMealHeader" Background="#F0F4ED" BorderBrush="#9BB69F" BorderThickness="3,0,0,0" Padding="10,7"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource Accent}" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding ProteinSummary}" Style="{StaticResource Caption}"/></StackPanel></Border>
                        <Border Margin="14,4,0,0" BorderBrush="#D1DDD0" BorderThickness="1,0,0,0" Padding="10,0,0,0"><ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border x:Name="ContinuousEntryCard" Background="#FBFCFA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="4" Padding="10,10,8,6" Margin="0,4,0,0">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                              <TextBlock Text="{Binding FoodNameSnapshot}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding MealNameSnapshot}" Style="{StaticResource Caption}" Margin="0,0,10,0" /><TextBlock Text="{Binding LocalTime}" Style="{StaticResource Caption}" Margin="0,0,10,0" /><TextBlock Text="{Binding EnergyKcal, StringFormat={}{0:0.0} 大卡}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" /></WrapPanel>
                              <TextBlock Text="{Binding Calculation}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                              <TextBlock Text="{Binding ProteinText, StringFormat=蛋白质 {0}}" Style="{StaticResource Caption}"/>
                              <TextBlock Text="{Binding PreparationSnapshot}" Style="{StaticResource Caption}" />
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxHeight="38" ToolTip="{Binding Note}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                              <Button x:Name="EditListedEntryButton" Content="修改" Command="{Binding DataContext.EditListedEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" MinHeight="32" Margin="0,0,0,6" AutomationProperties.Name="{Binding FoodNameSnapshot, StringFormat=修改{0}}" />
                              <Button x:Name="DeleteListedEntryButton" Content="删除" Command="{Binding DataContext.DeleteListedEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,5" MinHeight="32" Margin="0" AutomationProperties.Name="{Binding FoodNameSnapshot, StringFormat=删除{0}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
