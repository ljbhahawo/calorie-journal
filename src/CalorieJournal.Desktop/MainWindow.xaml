              <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="108"/>
              <DataGridTextColumn Header="体重 kg" Binding="{Binding WeightKg, StringFormat=F2}" Width="82"/>
              <DataGridTextColumn Header="BMI" Binding="{Binding BmiText}" Width="85"/>
              <DataGridTextColumn Header="静息 大卡/日" Binding="{Binding RestingText}" Width="130"/>
              <DataGridTextColumn Header="身高 cm" Binding="{Binding HeightCm, StringFormat=F1, TargetNullValue=—}" Width="85"/>
              <DataGridTextColumn Header="年龄" Binding="{Binding AgeYears, TargetNullValue=—}" Width="65"/>
              <DataGridTextColumn Header="公式" Binding="{Binding FormulaSexText}" Width="85"/>
              <DataGridTextColumn Header="腰围 cm" Binding="{Binding WaistCm, StringFormat=F1, TargetNullValue=—}" Width="85"/>
