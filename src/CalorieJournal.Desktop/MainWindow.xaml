          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="身体记录">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="288"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding BodyHeading}" Style="{StaticResource Heading}" Margin="18,18,18,8"/>
