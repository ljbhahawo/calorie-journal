                    <DataGridTextColumn Header="食物" Binding="{Binding Name}" Width="230" /><DataGridTextColumn Header="大卡 / 100g" Binding="{Binding KcalPer100g, StringFormat=N2}" Width="120" ElementStyle="{StaticResource EnergyCell}" />
                    <DataGridTextColumn Header="蛋白质 / 100g" Binding="{Binding ProteinText}" Width="130"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90" /><DataGridTextColumn Header="状态" Binding="{Binding Preparation}" Width="220" /><DataGridTextColumn Header="来源" Binding="{Binding SourceSummary}" Width="280" />
