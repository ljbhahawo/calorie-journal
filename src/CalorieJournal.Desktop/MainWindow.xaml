          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="设置与数据">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
              <TextBlock Text="数据与备份" Style="{StaticResource Heading}" /><TextBlock Text="让日常记录安心保存在本机" Style="{StaticResource Caption}" Margin="0,0,0,22" />
              <TextBlock Text="完整备份" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="包含食物库、餐次和全部摄入。恢复将替换当前工作数据，并先自动备份现有内容。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14" />
