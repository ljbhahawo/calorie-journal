              <Border Grid.Row="2" Padding="20,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><WrapPanel><Button x:Name="UseFoodButton" Content="用选中食物记录摄入" Command="{Binding UseFoodCommand}" Style="{StaticResource PrimaryButton}" /><Button x:Name="OpenFoodLookupButton" Content="查找热量资料" Command="{Binding OpenFoodLookupCommand}" /></WrapPanel></Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="历史查询">
        <Border Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
