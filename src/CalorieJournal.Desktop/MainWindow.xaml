                <TextBlock Text="录入偏好" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="DefaultWeightSettingBox" Content="新建摄入默认按重量计算" IsChecked="{Binding SettingsDefaultWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="发现新的手动食物资料时" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="NewFoodPolicyBox" ItemsSource="{Binding NewFoodModes}" SelectedIndex="{Binding SettingsFoodMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新资料入库方式"/>
                <TextBlock Text="需要有效的每100克热量；不推算缺失资料，不覆盖已有食物。设置只影响后续操作，当前草稿和历史保持不变。" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                <WrapPanel><Button x:Name="SaveSettingsButton" Content="保存录入设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,10"/><Button x:Name="ReloadSettingsButton" Content="还原已保存设置" Command="{Binding ReloadSettingsCommand}" Margin="0,0,0,10"/></WrapPanel>
                <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="数据目录" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,0,0,18" />
                <TextBlock Text="食物数据来源" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="{Binding FoodAttribution}" Style="{StaticResource Caption}" />
                <Border Background="#F1F5EC" CornerRadius="7" Padding="12" Margin="0,18,0,0"><TextBlock Text="修改食物库只影响新记录，历史保留当时数值。更新与回滚说明随程序包提供。" Style="{StaticResource Caption}" /></Border>
              </StackPanel></Border>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
              <TextBlock Text="餐次管理" Style="{StaticResource Heading}" /><TextBlock Text="按自己的习惯安排早餐、加餐或夜宵" Style="{StaticResource Caption}" Margin="0,0,0,18" />
              <DataGrid x:Name="MealsGrid" ItemsSource="{Binding AllMeals}" SelectedItem="{Binding SelectedMeal}" Height="222"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="顺序" Binding="{Binding SortOrder}" Width="75" /><DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="70" /></DataGrid.Columns></DataGrid>
              <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="餐次名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MealNameBox" Text="{Binding MealName, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="餐次名称" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="顺序 · 0—10000" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MealOrderBox" Text="{Binding MealOrder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="餐次显示顺序" /></StackPanel>
              </Grid>
              <CheckBox Content="启用此餐次" IsChecked="{Binding MealActive}" />
              <WrapPanel><Button x:Name="SaveMealButton" Content="保存餐次" Command="{Binding SaveMealCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,12" /><Button x:Name="NewMealButton" Content="新增餐次" Command="{Binding NewMealCommand}" Margin="0,0,0,12" /></WrapPanel>
