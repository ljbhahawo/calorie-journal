                <Button x:Name="DeleteFoodButton" Content="删除此食物" Command="{Binding DeleteFoodCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel></Border>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Margin="20,18,20,4">
