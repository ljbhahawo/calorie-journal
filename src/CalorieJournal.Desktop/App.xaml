<Application x:Class="CalorieJournal.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#266A58" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Background" Value="#F5F7F5" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,3,0,10" /><Setter Property="MinHeight" Value="32" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="0,3,0,10" /><Setter Property="MinHeight" Value="32" /></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,3,8,10" /><Setter Property="MinHeight" Value="32" /></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="RowHeight" Value="36" /><Setter Property="ColumnHeaderHeight" Value="36" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="BorderBrush" Value="#DCE4DF" /><Setter Property="AlternatingRowBackground" Value="#F5F8F6" /><Setter Property="EnableRowVirtualization" Value="True" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DCE4DF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="18" /></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,14" /></Style>
  </Application.Resources>
</Application>
