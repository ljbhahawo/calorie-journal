<UserControl x:Class="CalorieJournal.Desktop.SheetJournalView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CalorieJournal.Desktop">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="SheetText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="6,5"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style x:Key="SheetCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style x:Key="SheetCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="4,3"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><DockPanel><TextBlock Text="每日记录 · 表格" Style="{StaticResource Heading}"/><Button x:Name="SheetTemplatesButton" Content="餐食模板" Command="{Binding OpenTemplatesCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0"/></DockPanel>
   <WrapPanel><DatePicker x:Name="SheetFromPicker" SelectedDate="{Binding SheetFrom}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="140" Margin="0,0,6,8" AutomationProperties.Name="表格开始日期"/><DatePicker x:Name="SheetToPicker" SelectedDate="{Binding SheetTo}" DisplayDateEnd="{Binding TodayDate, Mode=OneWay}" Width="140" Margin="0,0,6,8" AutomationProperties.Name="表格结束日期"/><Button x:Name="QuerySheetButton" Content="查询" Command="{Binding QuerySheetCommand}" Margin="0,0,6,8"/><Button x:Name="TodaySheetButton" Content="今天" Command="{Binding TodaySheetCommand}" Margin="0,0,6,8"/></WrapPanel>
   <TextBlock Text="{Binding SheetRangeText}" Style="{StaticResource Caption}"/><TextBlock Text="新增一行后填写；回车或点击行外保存。名称与本项大卡固定显示，操作在最右侧。展开行可填写日期、餐次和备注；备注回车换行，Ctrl+Enter保存。" Style="{StaticResource Caption}"/>
  </StackPanel>
  <ListBox x:Name="SheetDaysList" Grid.Row="1" ItemsSource="{Binding SheetDays}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch" AutomationProperties.Name="按日按餐摄入表格">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12">
    <StackPanel><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
     <ItemsControl ItemsSource="{Binding Meals}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Margin="14,4,0,10" BorderBrush="#BED1C1" BorderThickness="3,0,0,0" Padding="10,0,0,0"><StackPanel>
       <DockPanel Background="#EAF1E7" Margin="0,0,0,3"><Button x:Name="AddSheetRowButton" Content="＋ 新增一行" Command="{Binding AddCommand}" Click="RowAdded" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="6" Padding="10,5"/><StackPanel Margin="8,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <DataGrid x:Name="SheetRowsGrid" ItemsSource="{Binding Rows}" MaxHeight="500" MinHeight="48" MinRowHeight="48" IsReadOnly="True" FrozenColumnCount="2" CanUserReorderColumns="False" AreRowDetailsFrozen="True" VirtualizingPanel.VirtualizationMode="Standard" CellStyle="{StaticResource SheetCell}" GridLinesVisibility="All" VerticalGridLinesBrush="{StaticResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowDetailsVisibilityMode="VisibleWhenSelected" Loaded="GridLoaded" PreviewKeyDown="RowKeyDown" PreviewMouseWheel="RowMouseWheel" AutomationProperties.Name="餐次摄入明细表格">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="食物名称 · 必填" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:FoodNameInput x:Name="SheetFoodInput"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="本项大卡" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock x:Name="SheetKcalPreview" Text="{Binding EnergyPreview}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="计算方式" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox x:Name="SheetWeightModeBox" Content="按重量" IsChecked="{Binding WeightMode, UpdateSourceTrigger=PropertyChanged}" Margin="0" ToolTip="取消勾选后填写直接本项能量"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="可食重量" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid IsEnabled="{Binding WeightMode}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBox x:Name="SheetWeightBox" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SheetText}" AutomationProperties.Name="行内可食重量"/><ComboBox Grid.Column="1" ItemsSource="{Binding WeightUnits}" SelectedItem="{Binding WeightUnit}" Style="{StaticResource SheetCombo}" AutomationProperties.Name="行内重量单位"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="每100克能量" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid IsEnabled="{Binding WeightMode}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBox x:Name="SheetUnitEnergyBox" Text="{Binding UnitEnergy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SheetText}" AutomationProperties.Name="行内每100克能量"/><ComboBox x:Name="SheetUnitEnergyTypeBox" Grid.Column="1" ItemsSource="{Binding EnergyUnits}" SelectedItem="{Binding UnitEnergyType}" Style="{StaticResource SheetCombo}" AutomationProperties.Name="行内每100克能量单位"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="直接本项能量" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBox x:Name="SheetDirectEnergyBox" Text="{Binding DirectEnergy, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="DirectClicked" GotKeyboardFocus="DirectFocused" Style="{StaticResource SheetText}" AutomationProperties.Name="行内直接本项热量"/><ComboBox x:Name="SheetDirectEnergyTypeBox" Grid.Column="1" ItemsSource="{Binding EnergyUnits}" SelectedItem="{Binding DirectEnergyType}" Style="{StaticResource SheetCombo}" AutomationProperties.Name="行内本项能量单位"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="蛋白质 · g · 选填" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid ToolTip="{Binding ProteinPreview}"><TextBox x:Name="SheetUnitProteinBox" Text="{Binding UnitProtein, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SheetText}" AutomationProperties.Name="行内每100克蛋白质" Visibility="{Binding WeightMode, Converter={StaticResource BoolVisibility}}" ToolTip="每100克蛋白质g"/><TextBox x:Name="SheetDirectProteinBox" Text="{Binding DirectProtein, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SheetText}" AutomationProperties.Name="行内直接本项蛋白质" Visibility="{Binding DirectMode, Converter={StaticResource BoolVisibility}}" ToolTip="本项蛋白质g"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="操作" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><Button x:Name="SaveSheetRowButton" Content="保存" Command="{Binding SaveCommand}" Padding="7,4" MinHeight="34" Margin="0,0,4,0"/><Button x:Name="CancelSheetRowButton" Content="{Binding DiscardText}" Command="{Binding CancelCommand}" Padding="7,4" MinHeight="34" Margin="0" ToolTip="仅放弃当前行未保存的内容，不删除已保存的记录"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate><DataTemplate>
         <Border Padding="10" Background="#F6F9F3" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}" HorizontalAlignment="Left"><StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="#A44034"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock x:Name="SheetProteinPreview" Text="{Binding ProteinPreview}" TextWrapping="Wrap" Style="{StaticResource Caption}" Visibility="{Binding ProteinEnabled, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,4"/>
          <Expander x:Name="SheetDetailsExpander" Header="日期、餐次、时间、来源与更多操作" IsExpanded="False"><StackPanel>
           <WrapPanel Margin="0,6,0,0"><StackPanel Width="145" Margin="0,0,8,0"><TextBlock Text="日期 · 必填" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="SheetDatePicker" SelectedDate="{Binding DateInput}" DisplayDateEnd="{Binding DataContext.TodayDate, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" AutomationProperties.Name="行内记录日期"/></StackPanel><StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="餐次 · 必选" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SheetMealBox" ItemsSource="{Binding Meals}" SelectedItem="{Binding Meal}" DisplayMemberPath="Name" AutomationProperties.Name="行内餐次"/></StackPanel><StackPanel Width="110"><TextBlock Text="时间 HH:mm · 选填" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SheetTimeBox" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="行内时间"/></StackPanel></WrapPanel>
           <TextBlock Text="生熟、品牌或加工状态" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SheetPreparationBox" Text="{Binding Preparation, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="行内食物状态"/>
           <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SheetNoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" MinHeight="48" AutomationProperties.Name="行内备注"/>
           <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding WeightDescription}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
           <WrapPanel><Button x:Name="SheetWeightConversionButton" Content="可食重量 / 常用份量" Command="{Binding ConvertWeightCommand}" IsEnabled="{Binding WeightMode}" Margin="0,0,8,8"/><Button x:Name="SheetManualSourceButton" Content="改为手动来源" Command="{Binding ManualSourceCommand}" Margin="0,0,8,8"/><Button x:Name="DeleteSheetRowButton" Content="删除已存记录" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/></WrapPanel>
          </StackPanel></Expander>
         </StackPanel></Border>
        </DataTemplate></DataGrid.RowDetailsTemplate>
       </DataGrid>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="EarlierSheetButton" Content="加载更早30天" Command="{Binding EarlierSheetCommand}"/><TextBlock Text="回车或点击行外保存 · 未完成的草稿不计入合计" Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel>
 </Grid>
</UserControl>
