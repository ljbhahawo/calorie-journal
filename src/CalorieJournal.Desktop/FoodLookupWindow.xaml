<Window x:Class="CalorieJournal.Desktop.FoodLookupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="查找食物热量资料" Width="1100" Height="780" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="查找热量资料" Style="{StaticResource Heading}"/>
   <TextBlock Text="每100克大卡 · 请核对生熟、品牌及可食部分。普通搜索离线，联网更新仅下载官方公开资料。" Style="{StaticResource Caption}"/>
   <Grid Margin="0,14,0,0" IsEnabled="{Binding NotBusy}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="LookupQueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,8,8" AutomationProperties.Name="热量资料关键词"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox>
    <ComboBox x:Name="LookupProviderBox" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" Margin="0,0,8,8" AutomationProperties.Name="热量资料来源"/>
    <Button x:Name="LookupSearchButton" Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
   </Grid>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="80"/><RowDefinition Height="5"/><RowDefinition Height="2*" MinHeight="60"/></Grid.RowDefinitions>
   <DataGrid x:Name="LookupResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" IsEnabled="{Binding NotBusy}" AutomationProperties.Name="热量资料结果">
    <DataGrid.Columns><DataGridTextColumn Header="食物名称" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="大卡 / 100g" Binding="{Binding KcalPer100g, StringFormat=N2}" Width="120" ElementStyle="{StaticResource EnergyCell}"/><DataGridTextColumn Header="来源" Binding="{Binding Provider}" Width="130"/><DataGridTextColumn Header="加工状态与描述" Binding="{Binding Preparation}" Width="450"/></DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
   <TextBox x:Name="LookupDetailsBox" Grid.Row="2" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Margin="0,8,0,0" AutomationProperties.Name="资料来源详情"/>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource Caption}" MaxHeight="38" ToolTip="{Binding CatalogStatus}"/>
   <TextBlock x:Name="LookupStatusText" Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="54" ToolTip="{Binding Status}" Margin="0,7,0,10" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel><Button x:Name="LookupUpdateButton" Content="联网更新TFDA资料" Command="{Binding UpdateCommand}"/><Button x:Name="LookupCancelUpdateButton" Content="取消更新" Command="{Binding CancelUpdateCommand}"/><Button x:Name="LookupBundledButton" Content="使用随包资料" Command="{Binding BundledCommand}"/></WrapPanel>
   <WrapPanel Margin="0,6,0,0"><Button x:Name="LookupChooseButton" Content="带入新增食物" Click="ChooseFood" IsEnabled="{Binding NotBusy}" Style="{StaticResource PrimaryButton}"/><Button x:Name="LookupSourceButton" Content="查看原始网页" Command="{Binding OpenSourceCommand}"/><Button x:Name="LookupCloseButton" Content="关闭" Click="CloseWindow"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
