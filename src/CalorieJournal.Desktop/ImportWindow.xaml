<Window x:Class="CalorieJournal.Desktop.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入历史记录" Width="1180" Height="800" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Language="zh-CN">
  <Window.Resources>
    <Style x:Key="GridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="5,3" /></Style>
    <Style x:Key="RowText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style x:Key="ReviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="12" /></Style>
  </Window.Resources>
  <Grid Margin="22,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="导入历史记录" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="先识别、再核对；导入前自动备份，追加记录并保留原文" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
    <TabControl x:Name="ImportTabs" Grid.Row="1" SelectedIndex="{Binding TabIndex}" IsEnabled="{Binding CanEdit}">
      <TabItem Header="1. 粘贴记录">
        <Border Style="{StaticResource Card}"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel>
              <StackPanel Margin="0,0,18,0"><TextBlock Text="粘贴格式" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ImportFormatBox" Width="180" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" AutomationProperties.Name="粘贴格式" /></StackPanel>
              <StackPanel><TextBlock Text="没有年份的日期采用" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ImportYearBox" Width="130" HorizontalAlignment="Left" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" AutomationProperties.Name="缺省年份" /></StackPanel>
            </WrapPanel>
            <TextBlock Text="文字可包含日期标题、餐次、分项和合计。复制表格的首行需有：日期、餐次、名称、大卡；列顺序不限，可另含时间和备注。" Style="{StaticResource Caption}" Margin="0,0,0,12" />
          </StackPanel>
          <TextBox x:Name="ImportRawBox" Grid.Row="1" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Margin="0" MaxLength="200001" AutomationProperties.Name="原始摄入记录" />
          <WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="ParseImportButton" Content="生成导入草稿" Command="{Binding ParseCommand}" Style="{StaticResource PrimaryButton}" /><TextBlock Text="最多20万字符、1000条草稿；此步骤不写入数据库" Style="{StaticResource Caption}" VerticalAlignment="Center" /></WrapPanel>
        </Grid></Border>
      </TabItem>
      <TabItem Header="2. 核对与导入">
        <ScrollViewer x:Name="ReviewPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource Card}" Padding="16" Height="{Binding ViewportHeight, ElementName=ReviewPageScroll}" MinHeight="430"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="双击修改；区间需填估计值，未知餐次需对应。合计与明细不可叠加。" Style="{StaticResource Caption}" />
            <WrapPanel Margin="0,8,0,10">
              <Button x:Name="PreferDetailsButton" Content="优先选择明细" Command="{Binding PreferDetailsCommand}" Style="{StaticResource ReviewButton}" />
              <Button x:Name="PreferTotalsButton" Content="优先选择合计" Command="{Binding PreferTotalsCommand}" Style="{StaticResource ReviewButton}" />
              <Button x:Name="LowerImportButton" Content="选中行取下限" Command="{Binding LowerCommand}" Style="{StaticResource ReviewButton}" />
              <Button x:Name="MiddleImportButton" Content="取中值" Command="{Binding MiddleCommand}" Style="{StaticResource ReviewButton}" />
              <Button x:Name="UpperImportButton" Content="取上限" Command="{Binding UpperCommand}" Style="{StaticResource ReviewButton}" />
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="ImportGrid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="False" RowHeight="48" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="导入" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60" />
              <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="100" />
              <DataGridTextColumn Header="日期" Binding="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="126" EditingElementStyle="{StaticResource GridEditor}" />
              <DataGridTemplateColumn Header="餐次" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding MealOptions}" SelectedItem="{Binding MealName, UpdateSourceTrigger=PropertyChanged}" Margin="0" MinHeight="30" Padding="5" FontSize="12" AutomationProperties.Name="导入餐次" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="210" EditingElementStyle="{StaticResource GridEditor}" ElementStyle="{StaticResource RowText}" />
              <DataGridTextColumn Header="大卡" Binding="{Binding EnergyText, UpdateSourceTrigger=PropertyChanged}" Width="90" EditingElementStyle="{StaticResource GridEditor}" />
              <DataGridTextColumn Header="时间" Binding="{Binding LocalTime, UpdateSourceTrigger=PropertyChanged}" Width="85" EditingElementStyle="{StaticResource GridEditor}" />
              <DataGridTextColumn Header="状态与提示" Binding="{Binding State}" Width="360" IsReadOnly="True" />
              <DataGridTextColumn Header="备注" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="260" EditingElementStyle="{StaticResource GridEditor}" />
            </DataGrid.Columns>
          </DataGrid>
          <Expander x:Name="ImportOriginalExpander" Grid.Row="2" Header="查看选中行的原文与识别提示" FontSize="12" Margin="0,8,0,8">
            <Border Background="#F1F5EC" CornerRadius="6" Padding="8" MaxHeight="95"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedHint}" Style="{StaticResource Caption}" /><TextBlock x:Name="ImportOriginalText" Text="{Binding SelectedOriginal}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12" /></StackPanel></ScrollViewer></Border>
          </Expander>
          <StackPanel Grid.Row="3">
            <CheckBox x:Name="AllowImportDuplicatesBox" Content="明确允许疑似重复项（同一原文行仍不能重复导入）" IsChecked="{Binding AllowDuplicates}" FontSize="12" Margin="0,0,0,8" />
            <CheckBox x:Name="ImportReviewedBox" Content="我已核对所选记录的年份、餐次、估计值和合计方式" IsChecked="{Binding ReviewConfirmed}" FontSize="12" Margin="0,0,0,10" />
            <WrapPanel><Button x:Name="ValidateImportButton" Content="校验所选记录" Command="{Binding ValidateCommand}" /><Button x:Name="CommitImportButton" Content="备份并导入" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" Style="{StaticResource PrimaryButton}" /></WrapPanel>
          </StackPanel>
        </Grid></Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="ImportStatusText" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" MaxHeight="72" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="CloseImportButton" Grid.Column="1" Content="关闭" Click="CloseWindow" IsEnabled="{Binding NotBusy}" Margin="0" />
    </Grid>
  </Grid>
</Window>
