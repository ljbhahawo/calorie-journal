<UserControl x:Class="CalorieJournal.Desktop.FoodNameInput"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="NameChanged" GotKeyboardFocus="NameFocused" PreviewKeyDown="NameKeyDown" LostKeyboardFocus="FocusLeft" MaxLength="100" Margin="0" Padding="6,5" AutomationProperties.Name="表格食物名称" ToolTip="输入中文、别名或英文，选择候选引用；也可手动填写"/>
  <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=NameInput}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Background="White" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="4" MinWidth="300" MaxWidth="480">
    <StackPanel><TextBlock Text="个人食物库 · 选择后带入单位资料" Style="{StaticResource Caption}" Margin="4"/>
     <ListBox x:Name="SuggestionsList" MaxHeight="240" BorderThickness="0" PreviewMouseLeftButtonUp="ChooseByMouse" PreviewKeyDown="SuggestionKeyDown" LostKeyboardFocus="FocusLeft" AutomationProperties.Name="食物联想候选">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Preparation}" TextWrapping="Wrap" Style="{StaticResource Caption}"/><TextBlock Text="{Binding OriginalName}" TextWrapping="Wrap" Style="{StaticResource Caption}"/><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding KcalPer100g, Mode=OneWay, StringFormat=F2}"/><Run Text=" 大卡/100g · 蛋白质 "/><Run Text="{Binding ProteinText, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding SourceSummary}" TextTrimming="CharacterEllipsis" MaxWidth="440" ToolTip="{Binding SourceSummary}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
